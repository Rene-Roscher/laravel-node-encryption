{
    "name": "rene-roscher/laravel-node-encryption-interop",
    "description": "Dev-only interop harness: verifies the Node.js port against the real Laravel encrypter and the Laravel classes that use it, and the Interop Envelope.",
    "license": "MIT",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/Rene-Roscher/laravel-interop"
        }
    ],
    "require": {
        "php": ">=8.2",
        "illuminate/encryption": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/database": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/cookie": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/session": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "rene-roscher/laravel-interop": "dev-main"
    },
    "config": {
        "optimize-autoloader": true
    }
}
